   "source": [
    "df = pd.read_csv('raw_data.csv')\n",
    "\n",
    "df2 = df.copy()\n",
    "\n",
    "df2 = df.drop_duplicates()\n",
    "\n",
    "df2 = df2.fillna(df2['age'].mean())\n",
    "\n",
    "df2 = df2.sort_values('income')\n",
    "df2 = df2.reset_index(drop=True)\n",
    "\n",
    "df2.to_csv('Sorted_data.csv')\n",
    "df2"
   ]
